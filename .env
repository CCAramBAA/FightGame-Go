# ==================== FightGame 环境变量 ====================

# Server
SERVER_PORT=8080
GIN_MODE=debug

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root123
DB_NAME=fight_game

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Log
LOG_LEVEL=info
LOG_FILE=logs/server.log

# JWT
JWT_SECRET=change-this-to-a-random-secret-in-production

# CORS - 允许的前端域名，用逗号分隔
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Frontend
VITE_WS_URL=ws://localhost:8080/ws
